 impl interpreter::Interp {
+    /// Select host-defined essential internal methods for an object after
+    /// its prototype has been initialized. Flags are monotonic: false leaves
+    /// an already-installed rule unchanged.
+    ///
+    /// `immutable_prototype` uses ECMA-262 #sec-set-immutable-prototype;
+    /// `always_extensible` makes [[PreventExtensions]] return false, as HTML
+    /// #windowproxy-preventextensions requires. Ordinary property descriptors
+    /// and Proxy invariant checks are unaffected. Rules live in internal
+    /// slots, so author strings and copied properties cannot address them.
+    /// Returns false for non-objects, Proxies, or an already non-extensible
+    /// object when always-extensible behavior is requested.
+    pub fn set_host_object_invariants(
+        &mut self,
+        object: &embed::Value,
+        immutable_prototype: bool,
+        always_extensible: bool,
+    ) -> bool {
+        let Some(object) = object.as_obj() else {
+            return false;
+        };
+        if self
+            .proxies
+            .contains_key(&(std::rc::Rc::as_ptr(object) as usize))
+        {
+            return false;
+        }
+        let mut object = object.borrow_mut();
+        if always_extensible && !object.extensible {
+            return false;
+        }
+        for (enabled, key) in [
+            (immutable_prototype, value::HOST_IMMUTABLE_PROTOTYPE),
+            (always_extensible, value::HOST_ALWAYS_EXTENSIBLE),
+        ] {
+            if enabled {
+                object.internal_slots_mut().insert(
+                    key,
+                    value::Property::data(embed::Value::Bool(true), false, false, false),
+                );
+            }
+        }
+        true
+    }
